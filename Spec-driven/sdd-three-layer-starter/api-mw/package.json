{
  "name": "api-mw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract/openapi.spec.ts",
    "contract:lint": "node tests/contract/validate-openapi.js"
  },
  "dependencies": {
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
